{
  "expo": {
    "name": "Cold Arms",
    "slug": "coldarms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coldarms",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.coldarms.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.coldarms.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "coldarms.com", "pathPrefix": "/verify-email" },
            { "scheme": "https", "host": "coldarms.com", "pathPrefix": "/reset-password" },
            { "scheme": "https", "host": "coldarms.com", "pathPrefix": "/en/verify-email" },
            { "scheme": "https", "host": "coldarms.com", "pathPrefix": "/en/reset-password" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cold Arms использует фото из галереи, чтобы поставить аватарку профиля.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0B0B0C",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f6f66c6-5eb3-4a78-8e36-dc23f92c9fe3"
      }
    },
    "owner": "alcher96"
  }
}
